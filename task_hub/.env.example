# Copy to task_hub/.env. Keep credentials out of Git.
MODEL_PROVIDER=ollama
# Choose an exact installed model name shown by `ollama list`.
MODEL_NAME=gemma4
MODEL_URL=http://127.0.0.1:11434
MODEL_API_KEY=

# These repositories are the only ones the runtime can access.
GITHUB_ALLOWED_REPOS=konankikesava/AIAgent
# Optional for public reads; needed for private reads and approved writes.
GITHUB_TOKEN=
# Enable only if you want agents to propose issues for your review.
GITHUB_WRITES_ENABLED=false

HUB_HOST=127.0.0.1
HUB_PORT=8765
HUB_WORKERS=2
HUB_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Set a long random token for Docker or any network binding.
HUB_AUTH_TOKEN=
